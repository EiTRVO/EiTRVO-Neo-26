<UserControl x:Class="EiTRVO.UI.Panels.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock Text="EiTRVO Management Panel"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="选择账户与实例，启动游戏"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Row 1: Two-column card layout -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: Accounts -->
            <GroupBox Grid.Column="0" Header="账户" Padding="8">
                <ListBox x:Name="lstAccounts"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         ItemTemplate="{StaticResource HomeAccountCardTemplate}"
                         ItemContainerStyle="{StaticResource NoSelectListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0">
                </ListBox>
            </GroupBox>

            <!-- Right column: Instances -->
            <GroupBox Grid.Column="2" Header="实例" Padding="8">
                <ListBox x:Name="lstInstances"
                         ItemsSource="{Binding LocalInstances}"
                         SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                         ItemTemplate="{StaticResource HomeInstanceCardTemplate}"
                         ItemContainerStyle="{StaticResource NoSelectListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0">
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Row 2: Bottom-right action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,14,24,16">
            <Button Content="强制关闭"
                    Style="{StaticResource DangerBtn}"
                    Height="48" FontSize="14" FontWeight="SemiBold"
                    MinWidth="130" Padding="18,6" Margin="0,0,10,0"
                    Command="{Binding KillGameCommand}"
                    IsEnabled="{Binding IsGameRunning}"/>
            <Button x:Name="btnQuickLaunch"
                    Height="48" MinWidth="130"
                    Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"
                    Padding="14,4" Margin="0,0,10,0"
                    Command="{Binding QuickLaunchCommand}"
                    IsEnabled="{Binding HasLastLaunch}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource AccentGreen}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Content>
                    <StackPanel>
                        <TextBlock Text="快速启动" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LastLaunchedInstanceName}"
                                   FontSize="10" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button x:Name="btnLaunch"
                    Content="启动游戏"
                    Style="{StaticResource LaunchBtn}"
                    Height="48" MinWidth="130" FontSize="14"
                    Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding IsLaunching, Converter={StaticResource BoolInvertConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
