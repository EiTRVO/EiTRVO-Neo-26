<UserControl x:Class="EiTRVO.UI.Panels.InstallationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: back + version info -->
                <Border Grid.Row="0" Padding="24,16,24,10"
                        BorderBrush="{DynamicResource SidebarBorder}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← 返回"
                                Style="{StaticResource CardBtn}"
                                Foreground="{DynamicResource AccentBlue}"
                                Height="28" FontSize="12" Padding="10,3"
                                Command="{Binding GoBackCommand}"/>
                        <Border Background="{DynamicResource AccentBlue}"
                                CornerRadius="3" Padding="5,1"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding VersionType}"
                                       FontSize="9" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding VersionId}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="安装"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="24,12,24,16">
                    <StackPanel>
                        <!-- Instance Name -->
                        <GroupBox Header="实例名称" Padding="12" Margin="0,4">
                            <TextBox Width="320" Height="30"
                                     Text="{Binding InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"/>
                        </GroupBox>

                        <!-- Mod Loader Selection -->
                        <GroupBox Header="Mod 加载器" Padding="12" Margin="0,4">
                            <StackPanel>
                                <!-- Horizontal card-style loader selection -->
                                <ListBox x:Name="lstLoaderCards"
                                         ItemsSource="{Binding LoaderOptions}"
                                         SelectedItem="{Binding SelectedLoaderOption, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource LoaderCardTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Height="46">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment"
                                                    Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Loader version cards -->
                                <ListBox Margin="0,8,0,0" MaxHeight="200"
                                         ItemsSource="{Binding LoaderVersions}"
                                         SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource LoaderVersionCardTemplate}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Background="Transparent"
                                         Visibility="{Binding IsModLoaderVersionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Fabric API coexistence -->
                                <CheckBox Content="同时安装 Fabric API"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          FontSize="12"
                                          IsChecked="{Binding WithFabricApi, Mode=TwoWay}"
                                          Visibility="{Binding IsFabricApiVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Fabric API version cards -->
                                <ListBox Margin="0,4,0,0" MaxHeight="150"
                                         ItemsSource="{Binding FabricApiVersions}"
                                         SelectedItem="{Binding SelectedFabricApiVersion, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource LoaderVersionCardTemplate}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Background="Transparent"
                                         Visibility="{Binding IsFabricApiVersionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- OptiFine coexistence -->
                                <CheckBox Content="同时安装 OptiFine（放入 mods 文件夹）"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          FontSize="12"
                                          IsChecked="{Binding WithOptiFine, Mode=TwoWay}"
                                          Visibility="{Binding IsOptiFineForForgeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- OptiFine version cards -->
                                <ListBox Margin="0,4,0,0" MaxHeight="150"
                                         ItemsSource="{Binding OptiFineForForgeVersions}"
                                         SelectedItem="{Binding SelectedOptiFineVersion, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource LoaderVersionCardTemplate}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Background="Transparent"
                                         Visibility="{Binding IsOptiFineDropdownVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Hint text -->
                                <TextBlock FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding ModLoaderHint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Install Button -->
                        <Button Content="开始安装"
                                Style="{StaticResource PrimaryBtn}"
                                Height="36" FontSize="14" FontWeight="Bold"
                                Padding="24,4" HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                Command="{Binding InstallCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
</UserControl>
