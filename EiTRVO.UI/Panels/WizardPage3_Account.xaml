<UserControl x:Class="EiTRVO.UI.Panels.WizardPage3_Account"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Title -->
            <TextBlock Text="添加账号" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="添加至少一个游戏账号以启动 Minecraft。之后可在主界面的账号页面管理。"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,20"/>

            <!-- Account creation buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="添加微软账号"
                        Style="{StaticResource PrimaryBtn}"
                        Height="32" FontSize="13" Padding="16,4"
                        Command="{Binding AddMicrosoftCommand}"/>
                <Button Content="添加第三方账号"
                        Style="{StaticResource CardBtn}"
                        Height="32" FontSize="13" Padding="12,4"
                        Margin="10,0,0,0"
                        Foreground="{DynamicResource AccentBlue}"
                        Command="{Binding ToggleYggdrasilFormCommand}"/>
                <Button Content="添加离线账号"
                        Style="{StaticResource CardBtn}"
                        Height="32" FontSize="13" Padding="12,4"
                        Margin="10,0,0,0"
                        Foreground="{DynamicResource AccentGreen}"
                        Command="{Binding ToggleOfflineFormCommand}"/>
            </StackPanel>

            <!-- Device Code Panel -->
            <Border Visibility="{Binding IsDeviceCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource Surface}" CornerRadius="8"
                    Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Microsoft 设备代码认证" FontWeight="Bold"
                               FontSize="14" Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="请在浏览器中打开以下链接（点击按钮自动打开）："
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding VerificationUri}"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                        <Button Content="打开网页"
                                Style="{StaticResource PrimaryBtn}"
                                Height="28" FontSize="12" Padding="12,2"
                                Margin="10,0,0,0"
                                Command="{Binding OpenBrowserCommand}"/>
                    </StackPanel>
                    <TextBlock Text="并输入以下代码（点击可复制）："
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               Margin="0,8,0,6"/>
                    <TextBlock Text="{Binding UserCode}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreen}"
                               Margin="0,0,0,12" Cursor="Hand"
                               MouseLeftButtonDown="UserCode_Click"/>
                    <TextBlock Text="{Binding DeviceStatus}"
                               Foreground="{DynamicResource AccentOrange}"
                               TextWrapping="Wrap" FontSize="12"
                               Margin="0,0,0,10"/>
                    <Button Content="取消认证"
                            Style="{StaticResource DangerBtn}"
                            Height="26" FontSize="12" Padding="10,2"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelAuthCommand}"/>
                </StackPanel>
            </Border>

            <!-- Yggdrasil Form Panel -->
            <Border Visibility="{Binding IsYggdrasilFormVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource Surface}" CornerRadius="8"
                    Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="第三方账号" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="验证服务器" FontWeight="SemiBold"
                               FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox Height="32" Margin="0,0,0,10"
                             Text="{Binding YggdrasilServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="邮箱" FontWeight="SemiBold"
                               FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox Height="32" Margin="0,0,0,10"
                             Text="{Binding YggdrasilEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="密码" FontWeight="SemiBold"
                               FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <PasswordBox x:Name="txtYggdrasilPassword"
                                 Height="32" Margin="0,0,0,12"
                                 PasswordChanged="TxtYggdrasilPassword_PasswordChanged"/>
                    <TextBlock Text="{Binding YggdrasilStatus}"
                               Foreground="{DynamicResource AccentOrange}"
                               TextWrapping="Wrap" FontSize="12"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="登录"
                                Style="{StaticResource PrimaryBtn}"
                                Height="28" Padding="12,3"
                                Command="{Binding YggdrasilLoginCommand}"/>
                        <Button Content="取消"
                                Style="{StaticResource DangerBtn}"
                                Height="28" Padding="10,3" Margin="10,0,0,0"
                                Command="{Binding CancelYggdrasilCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Offline Account Form Panel -->
            <Border Visibility="{Binding IsOfflineFormVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource Surface}" CornerRadius="8"
                    Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="添加离线账号" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="玩家名（3-16 位字母、数字或下划线）"
                               FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox Height="32" Margin="0,0,0,12"
                             Text="{Binding OfflinePlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="添加"
                                Style="{StaticResource PrimaryBtn}"
                                Height="28" Padding="12,3"
                                Command="{Binding AddOfflineAccountCommand}"/>
                        <Button Content="取消"
                                Style="{StaticResource DangerBtn}"
                                Height="28" Padding="10,3" Margin="10,0,0,0"
                                Command="{Binding CancelOfflineCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Added accounts list -->
            <TextBlock Text="已添加的账号" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,8,0,8"/>
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayText}" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentBlue}"
                                        CornerRadius="3" Padding="5,1"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountTypeLabel}"
                                               FontSize="9" Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state hint -->
            <TextBlock Text="尚未添加任何账号。请点击上方按钮添加。"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="4,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
