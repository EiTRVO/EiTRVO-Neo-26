<UserControl x:Class="EiTRVO.UI.Panels.WizardPage2_Security"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Title -->
            <TextBlock Text="安全设置" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="配置基本的安全与数据保护选项。所有设置均可在主界面的设置页面中随时修改。"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- ==================== EiTRVO Firewall ==================== -->
            <Border Background="{DynamicResource Surface}" CornerRadius="8"
                    Padding="20,18" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="EiTRVO Firewall" FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentBlue}"
                                CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="推荐" FontSize="9" Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="启动游戏时加固进程，阻止恶意子进程启动（如 cmd.exe、powershell.exe 等）。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding FirewallEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Left">
                        <TextBlock Text="启用 EiTRVO Firewall" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </CheckBox>

                    <!-- Advanced Defense (conditional) -->
                    <CheckBox IsChecked="{Binding AdvancedDefenseEnabled}"
                              IsEnabled="{Binding IsAdvancedDefenseAvailable}"
                              Margin="0,10,0,0"
                              Style="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Left">
                        <TextBlock Text="高级防御模式（文件系统 + DLL + TCP 连接监控）"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </CheckBox>
                    <TextBlock Text="需要更多系统资源，仅在需要最高安全性时开启。"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="44,2,0,0"/>

                    <Border Background="{DynamicResource DeepDark}" CornerRadius="4"
                            Padding="10,8" Margin="0,10,0,0">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="📍 位置：设置 → EiTRVO Firewall"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== Auto Backup ==================== -->
            <Border Background="{DynamicResource Surface}" CornerRadius="8"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="自动备份" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="定期备份 .minecraft 文件夹（存档、配置、资源包等），备份文件使用 AES 加密。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding BackupEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Left">
                        <TextBlock Text="启用自动备份" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </CheckBox>

                    <!-- Backup settings (shown when backup is enabled) -->
                    <StackPanel Margin="0,10,0,0"
                                IsEnabled="{Binding BackupEnabled}">
                        <!-- Interval -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="备份间隔：" FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Width="80"/>
                            <ComboBox Width="140" Height="28"
                                      ItemsSource="{Binding BackupIntervalOptions}"
                                      SelectedValue="{Binding BackupInterval}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"/>
                        </StackPanel>

                        <!-- Backup folder -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保存位置：" FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Width="80"/>
                            <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Width="280" Height="28"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="浏览..."
                                    Style="{StaticResource CardBtn}"
                                    Height="28" FontSize="12" Padding="10,2"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseBackupFolderCommand}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding ExcludeRedownloadable}"
                                  Margin="0,10,0,0">
                            <TextBlock Text="排除 assets/ 和 libraries/（可从 Mojang 重新下载）"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </CheckBox>
                    </StackPanel>

                    <Border Background="{DynamicResource DeepDark}" CornerRadius="4"
                            Padding="10,8" Margin="0,10,0,0">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="📍 位置：设置 → 备份与恢复"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
